# Copie este arquivo para ".env" no servidor de destino e preencha os valores reais.
# NUNCA coloque senhas reais neste arquivo .env.example - ele e versionado/distribuido.

FIREBIRD_HOST=localhost
FIREBIRD_DATABASE=C:\caminho\completo\para\BANCO.FDB
