# ===============================
# SERVER
# ===============================
# IMPORTANTE: cada variável em uma linha separada (evita NODE_ENV concatenado com a próxima linha)
PORT=3000
NODE_ENV=production

# Chave para assinatura de tokens JWT (gerar com: openssl rand -hex 32)
JWT_SECRET=
# Quanto tempo o utilizador permanece autenticado sem voltar a introduzir e-mail/senha (ex.: 7d, 30d, 12h). Default: 30d
# JWT_EXPIRES_IN=30d

# ===============================
# SUPABASE (obrigatório)
# ===============================
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ===============================
# WHATSAPP (UltraMsg)
# ===============================
# URL pública do backend (ex.: https://sua-api.seudominio.com)
APP_URL=

# Pasta persistente para mídias (imagens, áudios, PDFs). Os links no banco continuam /uploads/...
# Se vazio, usa ./uploads dentro do projeto — em cada deploy/atualização esse diretório costuma ser recriado
# vazio e as imagens antigas somem. Em Docker/VM: monte um volume e aponte UPLOADS_DIR para ele.
# UPLOADS_DIR=/var/lib/whatsapp-plataforma/uploads

# Webhook (UltraMSG): imagem, vídeo, figurinha, áudio e voz chegam com URL em S3/CDN — copiar para /uploads em background.
# Assim o histórico aponta para ficheiro no seu servidor (≥ 3 dias: disco persistente UPLOADS_DIR + backup; link remoto pode expirar ~24h).
# Reintento automático a cada 3h para mensagens ainda em https (falha transitória). Desligar: INBOUND_MEDIA_RETRY_DISABLED=1
# INBOUND_MEDIA_RETRY_INTERVAL_MS=10800000
# INBOUND_MEDIA_RETRY_BATCH=45
# INBOUND_MEDIA_RETRY_MAX_AGE_HOURS=168
# Hosts extra para fetch/proxy (CSV): MEDIA_PROXY_EXTRA_HOSTS=cdn.exemplo.com

# ─── Cloudflare R2 (armazenamento de mídia em nuvem) ─────────────────────────────
# Rollout gradual: SÓ as empresas em R2_COMPANY_IDS usam o R2 (default: apenas a 1).
# Todas as demais continuam em disco (/uploads). Se as credenciais abaixo ficarem
# vazias, o R2 é considerado desligado e NADA muda — o sistema inteiro segue em disco.
#
# Destino é 100% Cloudflare R2 (não AWS). O backend fala com o R2 pelo protocolo
# S3-compatível assinando as requisições em SigV4 (sem SDK da AWS).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=zaperp-media-prod
# R2_ENDPOINT= (opcional; default https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
# R2_COMPANY_IDS=1                     (CSV de company_id habilitados; default: 1)
#   → use R2_COMPANY_IDS=*  (ou "all"/"todas", ou R2_ALL_COMPANIES=1) para TODAS as empresas,
#     inclusive as criadas depois. Nesse modo as varreduras não filtram por empresa.
# R2_PRESIGN_EXPIRES_SECONDS=3600      (validade da URL assinada de leitura; default 1h; máx 604800)
# R2_MIRROR_INTERVAL_MS=300000         (intervalo da varredura de espelhamento; default 5min)
# R2_MIRROR_BATCH=100                  (tamanho do lote da varredura)
# R2_MIRROR_DISABLED=1                 (desliga a varredura periódica)
# R2 é o armazenamento ÚNICO das empresas habilitadas: a mídia é copiada ao bucket na hora e o
# arquivo local de staging é purgado depois de uma janela de segurança (tempo para a UltraMSG
# baixar mídia enviada por URL pública). Depois disso, resta só o R2.
# R2_LOCAL_CLEANUP_DELAY_MINUTES=5     (janela antes de purgar o local; 0 = imediato)
# R2_KEEP_LOCAL=1                      (nunca purga o local — mantém cópia; transição/depuração)
# Migração ÚNICA do histórico: ligue, reinicie o backend e ele migra TODAS as mídias antigas de
# /uploads para o R2 e libera o disco, sozinho (funciona mesmo com background jobs desligado).
# Depois que terminar (ver logs [mediaR2/historico]), DESLIGUE esta env.
# R2_MIGRATE_HISTORICO_ON_BOOT=1
#
# Retenção de mídia: após N dias (contados da DATA DA MENSAGEM) o ARQUIVO de mídia é apagado
# (R2 e/ou disco), MANTENDO a mensagem no histórico (bolha vira "(mídia expirada)"). IRREVERSÍVEL.
# Desligado por padrão. Escopo = empresas em R2 (hoje só a company 1). Ex.: 60 = 2 meses.
# MEDIA_RETENTION_DAYS=60
# MEDIA_RETENTION_INTERVAL_HOURS=24   (frequência da varredura; default 24h)

# Quando há mais do que uma linha ativa em empresa_zapi com o mesmo instance_id (erro de dados):
# - omitido ou "legacy": mantém o comportamento histórico — escolhe o MENOR company_id (sem mudar fluxo em produção).
# - "recent": escolhe a linha com atualizado_em mais recente (opt-in; pode alterar qual empresa recebe o webhook).
# WEBHOOK_INSTANCE_DUPLICATE_STRATEGY=recent

# Fallback por instanceId quando token estiver ausente/inválido (NÃO recomendado em produção)
# Default no código: true em dev, false em produção
# ALLOW_INSTANCEID_WEBHOOK_FALLBACK=0

# Base URL UltraMsg (default: https://api.ultramsg.com). Credenciais por empresa vêm de empresa_zapi.
# instance_token em empresa_zapi deve ser o token ATUAL do painel da instância; se rodar o token no UltraMSG
# e não atualizar a base, a API responde "Wrong token" e o envio pelo sistema falha.
ULTRAMSG_BASE_URL=https://api.ultramsg.com
# Delay entre envios em ms — evita bloqueio WhatsApp. Recomendado: 1000 (1s) para envios rápidos
# 0 = sem delay. Aplica-se a TODOS os envios (mensagem finalização, chatbot, regras, opt-out).
# ULTRAMSG_SEND_DELAY_MS=1000
# configureWebhooks: sendDelay (s), sendDelayMax (s) — sendDelayMax deve ser >= sendDelay
# ULTRAMSG_SEND_DELAY=1
# ULTRAMSG_SEND_DELAY_MAX=15
# ULTRAMSG_WEBHOOK_RETRIES=3
# ULTRAMSG_WEBHOOK_DOWNLOAD_MEDIA: true por padrão (áudio/imagem chegam com URL). Use false para desativar.
# Em produção: NÃO usados — dados vêm de empresa_zapi. Apenas para dev local sem banco configurado.
# ULTRAMSG_INSTANCE_ID=instance51534
# ULTRAMSG_TOKEN=r6ztawoqwcfhzrd

# Origens permitidas no CORS (separadas por vírgula; inclua o frontend)
CORS_ORIGINS=
# Origins adicionais apenas para reteste/local, sem substituir CORS_ORIGINS.
# ZAPERP_CORS_EXTRA_ORIGINS=http://localhost:5173
# Timeout do GET /chats/counts (ms). Default 20000 — evita 504 do proxy sem cabeçalhos CORS.
# CHAT_COUNTS_TIMEOUT_MS=20000
# Desativa worker/schedulers no start do servidor para reteste seguro de API local.
# ZAPERP_DISABLE_BACKGROUND_JOBS=1

# Busca em mensagens: tamanho de cada lote interno ao pesquisar texto antigo.
# Nao limita o total de resultados; o backend pagina todos os lotes ate terminar.
# CHAT_SEARCH_MESSAGES_PAGE_SIZE=1000

# ===============================
# Web Push (PWA / notificações fora do app)
# ===============================
# Gere um par de chaves VAPID (apenas no servidor; nunca commite a privada):
#   cd backend && npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Assunto de contato para o serviço push (formato mailto: ou URL https:)
# VAPID_SUBJECT=mailto:suporte@suaempresa.com.br
# TTL do Web Push em segundos (fallback quando celular está offline/desligado; padrão: 604800 = 7 dias)
# WEB_PUSH_TTL_SECONDS=604800
# Idade máxima da mensagem (ms) para aceitar push inbound (webhooks atrasados). Padrão: 900000 (15 min)
# WEB_PUSH_MAX_MESSAGE_AGE_MS=900000
# Logs detalhados do disparo inbound (1 = ativo). Produção: só temporário para diagnóstico.
# WEB_PUSH_DEBUG=0
# FCM em paralelo com Web Push na mesma conta (padrão: 1). Mantém celular com token FCM alertando mesmo quando há VAPID no PC.
# Use 0 apenas para rollout controlado/legado, pois pode silenciar o celular se outro dispositivo tiver Web Push.
# WEB_PUSH_FCM_ALONGSIDE_VAPID=1
# FCM nativo/mobile: obrigatório para tokens FCM em push_tokens. Use JSON puro ou base64 JSON; alternativa: caminho no servidor.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_PATH=

# Debug do webhook (1 = logs detalhados). Produção: deixe vazio.
# WHATSAPP_DEBUG=0

# Guard de envio WhatsApp: monitor nao bloqueia nem muda fluxo; soft aplica pacing leve.
# WHATSAPP_SEND_GUARD_MODE=monitor
# WHATSAPP_SEND_GUARD_AUTOMATION_INTERVAL_MS=1500
# WHATSAPP_SEND_GUARD_HUMAN_INTERVAL_MS=0

# Reconciliação de mensagens outbound presas em pending/sending (consulta UltraMSG por referenceId crm-{id})
# PENDING_OUTBOUND_RECONCILE_ENABLED=true
# PENDING_OUTBOUND_RECONCILE_INTERVAL_MINUTES=5
# PENDING_OUTBOUND_RECONCILE_GRACE_MINUTES=3
# PENDING_OUTBOUND_RECONCILE_FAIL_AFTER_MINUTES=60
# PENDING_OUTBOUND_RECONCILE_DEFER_MS=90000
# PENDING_OUTBOUND_RECONCILE_BATCH_LIMIT=50
# PENDING_OUTBOUND_RECONCILE_LOOKBACK_HOURS=168

# Banner "WhatsApp desconectado": oculto por padrão (Z-API removida). Use HIDE_WHATSAPP_DISCONNECT_BANNER=0 para exibir.
# HIDE_WHATSAPP_DISCONNECT_BANNER=0

# Feature flags (0 ou vazio = desativado; 1 ou true = ativado)
# FEATURE_REGRA_AUTO_WEBHOOK=0
# FEATURE_PROTECAO=1

# ===============================
# CRM AVANÇADO (SSO hand-off + sync de dados) — opcional
# ===============================
# As duas variáveis abaixo são o interruptor mestre da integração: valem para o
# SSO (crmSsoController) E para a sincronização empresa/contato/lead
# (services/crmSyncService). Sem elas, tudo é no-op silencioso.
# Segredo compartilhado (HS256) entre ZapERP e o CRM Avançado.
# Deve ser IDÊNTICO nos dois lados. Gere com: openssl rand -hex 32
# Também vai no header x-zaperp-secret de todos os POSTs de sync ao CRM.
# ZAP_SSO_SECRET=
# URL pública do CRM Avançado (ex.: https://crm.suaempresa.com). Sem barra final.
# CRM_AVANCADO_URL=

# ===============================
# OPENAI (IA do Dashboard) — opcional
# ===============================
# OPENAI_API_KEY=
# Limite mensal padrão por empresa quando empresas.ai_limit_per_month está vazio.
# Use 0 apenas para liberar explicitamente sem cota padrão.
# AI_MONTHLY_DEFAULT_LIMIT=300
# Tamanho máximo aproximado do JSON de dados enviado à etapa de redação da IA.
# AI_PROMPT_MAX_CHARS=28000

# ===============================
# META (WhatsApp Cloud API) — opcional
# ===============================
# WHATSAPP_TOKEN=
# META_ACCESS_TOKEN=
# META_APP_SECRET=
# PHONE_NUMBER_ID=
# WHATSAPP_PHONE_ID=
# WEBHOOK_VERIFY_TOKEN=

# ===============================
# CRON / JOBS (opcional)
# ===============================
# Secret para autenticar chamadas de cron (ex: timeout-inatividade). Use header X-Cron-Secret.
# Se vazio, rota POST /jobs/timeout-inatividade retorna 503.
CRON_SECRET=
# POST /jobs/admin-atendimento-alerta — alerta de resumo ao administrador (cron opcional; header X-Cron-Secret).
# O servidor tambem executa verificacao periodica em background.
# A liberacao e feita por empresa na tela: "Ativar alerta"; nao ha ENV de liberacao/bloqueio.
# Migracao: admin_atendimento_alerta_envios.
#
# ADMIN_ATENDIMENTO_ALERTA_INTERVAL_MINUTES=2    (1-15; intervalo entre verificacoes de horario)
# POST /jobs/atendimento-sem-resposta — alertas de conversa sem resposta do atendente (cron opcional).
# Migracao: 20260608000000_alerta_atendimento_sem_resposta.sql
# ATENDIMENTO_SEM_RESPOSTA_INTERVAL_MINUTES=1    (1-10; scheduler interno)
# ADMIN_ATENDIMENTO_ALERTA_DEBUG=1               (opcional: loga fora_da_janela com horario/fuso por empresa)
# Finalizacao automatica por ausencia do cliente (job interno no backend).
# A liberacao da funcionalidade e feita por empresa na tela de IA/chatbot:
# "Ativar finalizacao automatica por ausencia". Nao ha allowlist ou kill switch por ENV.
# Kill switch emergencial: use true apenas para pausar a rotina em incidente de producao.
# Nao libera empresa e nao substitui a configuracao da tela.
# ABSENCE_FINALIZATION_EMERGENCY_DISABLED=false
# Intervalo em minutos do job interno (minimo 1, maximo 60). Padrao: 5.
# ABSENCE_FINALIZATION_INTERVAL_MINUTES=5
# Maximo de conversas finalizadas por ciclo do job (protecao contra encerramento em massa). Padrao: 12.
# ABSENCE_FINALIZATION_MAX_PER_CYCLE=12
# Maximo de conversas analisadas por empresa por ciclo (ordena por ultima_atividade mais antiga primeiro). Padrao: 250.
# ABSENCE_FINALIZATION_SCAN_LIMIT=250
# Lote manual (POST /jobs/finalizacao-ausencia-lote). Padrao: 50.
# ABSENCE_FINALIZATION_LOTE_MAX=50

# Chatbot de triagem — anti-replay das boas-vindas.
# So inicia o menu de boas-vindas se a mensagem do cliente for recente (evita disparo por
# reentrega/re-sync de mensagem antiga da UltraMSG — "boas-vindas sem o cliente ter falado").
# Idade maxima do inbound em minutos; <= 0 desativa a guarda. Padrao: 360 (6 h).
# CHATBOT_WELCOME_MAX_INBOUND_AGE_MINUTES=360

# Operacional
# SYNC_BATCH_SIZE=50
# SYNC_INTERVAL_BETWEEN_BATCHES_MS=5000
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# CIRCUIT_BREAKER_RESET_MS=60000

# Rate limits por IP (ajuste conforme trafego real e proxy).
# Login deve ficar conservador; API e webhook precisam suportar varias empresas/atendentes.
# LOGIN_RATE_LIMIT_MAX=20
# API_RATE_LIMIT_MAX=30000
# WEBHOOK_RATE_LIMIT_MAX=60000
# AI_RATE_LIMIT_MAX=120
# DESTRUCTIVE_RATE_LIMIT_MAX=300

# Listagem de conversas (GET /api/chats).
# Padrao seguro para primeira pagina; maximo evita payloads enormes por empresa.
# CHAT_LIST_DEFAULT_LIMIT=100
# CHAT_LIST_MAX_LIMIT=250
# Busca de clientes sem conversa so entra com palavra + incluir_todos_clientes=1.
# CHAT_LIST_SEM_CONVERSA_LIMIT=50
# Busca da lista = nome/telefone da base de clientes (com/sem conversa). Defina como 1
# para tambem casar conversas pelo TEXTO das mensagens (comportamento antigo, que trazia
# conversas so por mencionar o termo no corpo). Padrao desligado.
# CHAT_SEARCH_INCLUDE_MESSAGE_TEXT=0

# Historico de mensagens (GET /api/chats/:id).
# Limita apenas o tamanho da pagina; o usuario pode carregar paginas antigas ate o fim.
# MESSAGE_HISTORY_DEFAULT_LIMIT=100
# MESSAGE_HISTORY_MAX_LIMIT=250

# Proxy reverso (Nginx/Cloudflare) — use 1 em produção
TRUST_PROXY=1

# ===============================
# SCRIPTS (criar-admin, etc.)
# ===============================
# ADMIN_EMAIL=admin@empresa.com
# ADMIN_SENHA=minhasenha
# ADMIN_NOME=Administrador

# ===============================
# DESENVOLVIMENTO
# ===============================
# Auto-refresh do SPA a cada N minutos (0 = desativado). Default: 5
# AUTO_REFRESH_MINUTES=5

# Timeout em ms para requisições UltraMsg. Default: 30000
# ULTRAMSG_TIMEOUT_MS=30000

# PostgreSQL (opcional; projeto usa Supabase por padrão)
# PG_HOST=localhost
# PG_USER=postgres
# PG_PASSWORD=
# PG_DATABASE=whatsapp
# PG_PORT=5432

# ===============================
# PRODUTOS (PostgreSQL separado)
# ===============================
PRODUTOS_DB_HOST=
PRODUTOS_DB_PORT=5432
PRODUTOS_DB_NAME=zaperp_produtos
PRODUTOS_DB_USER=postgres
PRODUTOS_DB_PASSWORD=
PRODUTOS_DB_SSL=false
# PRODUTOS_DB_POOL_MAX=10
# PRODUTOS_DB_IDLE_TIMEOUT_MS=30000
# PRODUTOS_DB_CONNECTION_TIMEOUT_MS=10000

# ===============================
# PRODUTOS SYNC (SQL Server -> PostgreSQL)
# ===============================
PRODUTOS_SYNC_ENABLED=false
PRODUTOS_SYNC_INTERNAL_ENABLED=false
PRODUTOS_SYNC_INTERVAL_MINUTES=30
# PRODUTOS_SYNC_BATCH_SIZE=500

# Preencha os campos WM_* abaixo apenas se for usar sincronização interna do backend.
# Se você já sincroniza externamente (ETL/serviço separado), pode deixar tudo vazio.
# WM_PRODUTOS_COMPANY_ID=1
# WM_SQLSERVER_HOST=
# WM_SQLSERVER_PORT=1433
# WM_SQLSERVER_DATABASE=
# WM_SQLSERVER_USER=
# WM_SQLSERVER_PASSWORD=
# WM_SQLSERVER_ENCRYPT=false
# WM_SQLSERVER_TRUST_CERT=true
# WM_SQLSERVER_POOL_MAX=5
# WM_SQLSERVER_IDLE_TIMEOUT_MS=30000
# WM_SQLSERVER_CONNECTION_TIMEOUT_MS=10000
# WM_SQLSERVER_REQUEST_TIMEOUT_MS=60000

# ===============================
# DISPARO DE MENSAGENS
# ===============================
# Upload de planilha (Etapa 2)
# DISPARO_UPLOAD_MAX_MB=20
# Limites de mídia por tipo (Etapa 4) — arquivos vão para temp em disco (não memoryStorage)
# DISPARO_IMAGEM_MAX_MB=5
# DISPARO_VIDEO_MAX_MB=32
# DISPARO_AUDIO_MAX_MB=16
# DISPARO_DOC_MAX_MB=100
# Uploads simultâneos de mídia do disparo
# DISPARO_MIDIA_MAX_CONCURRENT=3
# Tetos técnicos operacionais (Etapa 5) — não burlar proteções do provedor
# DISPARO_INTERVALO_MIN_PROVEDOR_SEC=3
# DISPARO_LIMITE_HORA_PROVEDOR=200
# DISPARO_LIMITE_DIA_PROVEDOR=2000

# ===============================
# DISPARO — FILA / WORKER (Etapa 7)
# ===============================
# Defaults SEGUROS no código: worker desligado, live desligado, dry-run ligado.
# Envio real SÓ com: DISPARO_WORKER_ENABLED=true AND DISPARO_LIVE_ENABLED=true AND DISPARO_DRY_RUN=false
# Processo SEPARADO do HTTP: npm run worker:disparo (ou PM2 app whatsapp-plataforma-disparo-worker).
# A API sozinha NÃO processa a fila. O worker deve subir junto com o backend (ecosystem.config.js).
# Produção: DISPARO_WORKER_ENABLED=true para o worker claimar a fila (worker ativo ≠ WhatsApp real).
# Dry-run marca enviada com provider_message_id=dry-{id} — NÃO chega no WhatsApp.
# Após dry-run concluído, use NOVA campanha para live. Janelas (Etapa 5) devem cobrir o horário do teste.
# DISPARO_WORKER_ENABLED=true
# DISPARO_LIVE_ENABLED=false
# DISPARO_DRY_RUN=true
# DISPARO_WORKER_POLL_MS=2000
# DISPARO_WORKER_HEARTBEAT_MS=10000
# DISPARO_WORKER_LEASE_SECONDS=120
# DISPARO_WORKER_BATCH_SIZE=5
# DISPARO_WORKER_ID=zaperp-disparo-1
# DISPARO_SEND_TIMEOUT_MS=45000
# DISPARO_MAX_TENTATIVAS=5
# DISPARO_BACKOFF_BASE_SEC=30
# DISPARO_BACKOFF_MAX_SEC=3600
# Allowlist opcional (somente estes números normalizados em dry-run/dev): 5511999999999,5511888888888
# DISPARO_TEST_ALLOWLIST=
